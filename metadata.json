{
  "$schema": "holoscan/module/v2",
  "module": {
    "name": "rticonnextdds-holoscan-module",
    "version": "0.1.0",
    "description": "RTI Connext DDS operators and reference applications for NVIDIA Holoscan 5",
    "authors": [
      {
        "name": "RTI Real-Time Innovations",
        "affiliation": "RTI Real-Time Innovations"
      }
    ],
    "license": "Apache-2.0",
    "language": ["C++"],
    "namespace": {
      "cpp": "rti::holoscan::dds"
    },
    "operator_names": ["PublisherOp", "SubscriberOp"],
    "subprojects": {
      "operators": ["dds"],
      "applications": ["shapes_demo_flatbuffers", "shapes_demo_xcdr"]
    },
    "holoscan_sdk": {
      "minimum_required_version": "5.0.0",
      "tested_versions": ["5.0.0"]
    },
    "platforms": ["x86_64", "aarch64"],
    "tags": ["DDS", "RTI Connext", "Networking and Distributed Computing"],
    "requirements": {
      "system_packages": ["ca-certificates", "curl", "openjdk-21-jre"]
    },
    "binary_packages": {},
    "dockerfile": "Dockerfile",
    "documentation": {
      "readme": "README.md"
    },
    "testing": {
      "cpp": "ctest"
    }
  }
}

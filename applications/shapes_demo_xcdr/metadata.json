{
  "$schema": "urn:holohub:application:v1",
  "application": {
    "name": "Connext DDS Shapes Demo with XCDR",
    "description": "Holoscan Shapes application carrying generated DDS samples through an XCDR Tensor",
    "authors": [
      {
        "name": "RTI Real-Time Innovations",
        "affiliation": "RTI Real-Time Innovations"
      }
    ],
    "language": "C++",
    "version": "0.1.0",
    "changelog": {
      "0.1.0": "Initial Holoscan 5 EA2 Shapes XCDR example"
    },
    "holoscan_sdk": {
      "minimum_required_version": "5.0.0",
      "tested_versions": ["5.0.0"]
    },
    "platforms": ["x86_64", "aarch64"],
    "tags": ["DDS", "RTI Connext", "XCDR", "Shapes Demo"],
    "ranking": 2,
    "requirements": {
      "operators": [{"name": "dds", "version": "0.1.0"}]
    },
    "default_mode": "publisher",
    "modes": {
      "publisher": {
        "description": "Run the Shapes XCDR publisher",
        "run": {
          "command": "<holohub_app_bin>/connext_shapes_demo_xcdr_publisher",
          "workdir": "holohub_app_bin", "docker_run_args": "-v $PWD/rti_license.dat:/workspace/rticonnextdds_holoscan_module/rti_license.dat:ro -e RTI_LICENSE_FILE=/workspace/rticonnextdds_holoscan_module/rti_license.dat"
        }
      },
      "subscriber": {
        "description": "Run the Shapes XCDR subscriber",
        "run": {
          "command": "<holohub_app_bin>/connext_shapes_demo_xcdr_subscriber",
          "workdir": "holohub_app_bin", "docker_run_args": "-v $PWD/rti_license.dat:/workspace/rticonnextdds_holoscan_module/rti_license.dat:ro -e RTI_LICENSE_FILE=/workspace/rticonnextdds_holoscan_module/rti_license.dat"
        }
      }
    }
  }
}

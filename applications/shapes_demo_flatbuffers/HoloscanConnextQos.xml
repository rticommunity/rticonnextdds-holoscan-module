<dds xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:noNamespaceSchemaLocation="https://community.rti.com/schema/7.7.0/rti_dds_profiles.xsd">
    <qos_library name="HoloscanConnext">
        <!-- RTI Shapes Demo uses best-effort shape topics by default. -->
        <qos_profile name="ShapesInterop" base_name="BuiltinQosLib::Generic.BestEffort">
            <datawriter_qos>
                <history>
                    <kind>KEEP_LAST_HISTORY_QOS</kind>
                    <depth>32</depth>
                </history>
            </datawriter_qos>
            <datareader_qos>
                <history>
                    <kind>KEEP_LAST_HISTORY_QOS</kind>
                    <depth>32</depth>
                </history>
            </datareader_qos>
        </qos_profile>
    </qos_library>
</dds>

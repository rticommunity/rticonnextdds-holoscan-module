{
  "application": {
    "name": "connext_shapes_holoviz",
    "description": "Holoscan 4.6 Shapes publisher/subscriber with Holoviz",
    "version": "0.1.0",
    "language": ["C++"],
    "holoscan_sdk": {"minimum_required_version": "4.6.0", "tested_versions": ["4.6.0"]},
    "platforms": ["aarch64", "x86_64"],
    "tags": ["DDS", "RTI Connext", "Holoviz", "Shapes Demo"],
    "requirements": [{"name": "RTI Connext DDS", "version": "7.7.0", "license": "Closed"}],
    "run": {
      "command": "require_rti_license && exec <holohub_app_bin>/connext_shapes_holoviz --headless --samples 40",
      "docker_run_args": "--network host -v $PWD/rti_license.dat:/opt/rti.com/rti_connext_dds-7.7.0/rti_license.dat:ro -e RTI_LICENSE_FILE=/opt/rti.com/rti_connext_dds-7.7.0/rti_license.dat"
    }
  }
}
